# Copy to .env (gitignored) and fill in. scripts/run_all.sh reads this file.
# --- required ---
ANTHROPIC_API_KEY=sk-ant-...            # Claude Haiku/Sonnet/Opus tiers + baseline evals
MODAL_TOKEN_ID=ak-...                   # from https://modal.com/settings/tokens
MODAL_TOKEN_SECRET=as-...
DEMO_KEY=change-me-to-a-random-string   # shared X-Demo-Key header protecting the public gateway
# --- optional ---
VERCEL_TOKEN=                           # https://vercel.com/account/tokens ; empty -> script stops before deploy and prints the manual command
VERCEL_PROJECT=model-spectrum           # Vercel project name to link/create
HF_TOKEN=                               # only for gated Hugging Face assets (none used by default)
GATEWAY_URL=                            # auto-detected from `modal deploy`; set manually if detection fails
RUN_OPUS=0                              # 1 = also run the Claude Opus 5 baseline (~$1.5 extra)
GIT_PUSH=1                              # 1 = commit measured results and push at the end
